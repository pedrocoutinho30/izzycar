<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Serve WebP automaticamente se o browser suportar e o ficheiro .webp existir
    RewriteCond %{HTTP_ACCEPT} image/webp
    RewriteCond %{REQUEST_FILENAME} (.*)\.(jpe?g|png)$
    RewriteCond %1\.webp -f
    RewriteRule (.*)\.(jpe?g|png)$ $1.webp [T=image/webp,L]

    # Proteção contra hotlinking: devolve 403 a imagens carregadas a partir de outros sites.
    # Só se aplica a /storage/ (fotos de viaturas e restantes uploads). Ficam de fora:
    #  - /img/ e /images/ (assets do site): não são abrangidos porque a regra só olha para /storage/;
    #  - /storage/settings/ (logo, usado nos emails), /storage/newsletter-offers/ (newsletter),
    #    /storage/proposals/ (foto no email de cotação aceite), /storage/brands/ e /storage/partners/:
    #    clientes de email/webmail (Outlook web, etc.) enviam Referer de terceiros.
    # Referers permitidos: vazio (acesso direto, apps, emails), o próprio site, localhost (desenvolvimento),
    # motores de busca e redes sociais (para não estragar SEO nem partilhas).
    RewriteCond %{REQUEST_URI} !^/storage/(settings|newsletter-offers|proposals|brands|partners)/ [NC]
    RewriteCond %{HTTP_REFERER} !^$
    RewriteCond %{HTTP_REFERER} !^https?://([a-z0-9-]+\.)*izzycar\.pt(:[0-9]+)?(/|$) [NC]
    RewriteCond %{HTTP_REFERER} !^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?(/|$) [NC]
    RewriteCond %{HTTP_REFERER} !^https?://([a-z0-9-]+\.)*(google|bing|yahoo)\.[a-z]{2,3}(\.[a-z]{2})?(:[0-9]+)?(/|$) [NC]
    RewriteCond %{HTTP_REFERER} !^https?://([a-z0-9-]+\.)*duckduckgo\.com(/|$) [NC]
    RewriteCond %{HTTP_REFERER} !^https?://([a-z0-9-]+\.)*(facebook|fb|instagram|whatsapp|twitter|linkedin)\.com(/|$) [NC]
    RewriteCond %{HTTP_REFERER} !^https?://([a-z0-9-]+\.)*(t\.co|x\.com|wa\.me|lnkd\.in)(/|$) [NC]
    RewriteRule ^storage/.+\.(jpe?g|png|webp|gif)$ - [F,NC,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Cache de longo prazo para assets estáticos
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # Cabeçalhos de segurança
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Strict-Transport-Security "max-age=31536000"

    # Cache 1 ano para CSS/JS/images
    <FilesMatch "\.(css|js|jpg|jpeg|png|gif|webp|svg|ico|woff|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # Garantir que o HTML não fica em cache
    <FilesMatch "\.(html|php)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
    # Uploads de clientes (retomas, avaliações, comprovativos, inspeções, documentos): fora dos motores de busca
    <If "%{REQUEST_URI} =~ m#^/storage/(consignment-evaluations|retoma|import-opportunities|inspections|comissoes|expenses|movements|proposals|files)/#">
        Header set X-Robots-Tag "noindex, noimageindex"
    </If>

    # WebP content-type correto
    <FilesMatch "\.webp$">
        Header set Content-Type "image/webp"
    </FilesMatch>
</IfModule>

# Compressão Gzip
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json text/plain text/xml
</IfModule>
